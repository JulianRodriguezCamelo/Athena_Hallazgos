# HALLAZGOS ERO — Variables de Entorno
# Copia este archivo como .env y completa los valores reales
# Genera claves seguras con: python -c "import secrets; print(secrets.token_hex(32))"

FLASK_ENV=production

# Claves secretas — OBLIGATORIO cambiar en producción
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_32_BYTES
JWT_SECRET_KEY=REEMPLAZAR_CON_CLAVE_JWT_ALEATORIA_32_BYTES

# Base de datos Oracle XE 21c
DB_HOST=oracle-server-host
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_USER=hallazgos
DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA

# CORS — dominios permitidos separados por coma
CORS_ORIGINS=https://tu-dominio.com,http://localhost:3000

# Redis
REDIS_URL=redis://redis:6379/0

# Correo electrónico (Gmail con App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=REEMPLAZAR_CON_APP_PASSWORD_GMAIL
MAIL_DEFAULT_SENDER=tu-correo@gmail.com

# Notificaciones y tareas programadas
NOTIFICATIONS_ENABLED=true
SCHEDULER_ENABLED=true

# URL pública del frontend (se hornea en el build de Next.js)
# En producción usar el dominio real: https://hallazgos.fiduprevisora.com
NEXT_PUBLIC_API_URL=https://tu-dominio.com
