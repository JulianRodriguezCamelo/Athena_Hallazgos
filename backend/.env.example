FLASK_ENV=production

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_POR_CLAVE_ALEATORIA_DE_64_CARACTERES
JWT_SECRET_KEY=CAMBIAR_POR_CLAVE_JWT_ALEATORIA_DE_64_CARACTERES

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hallazgos_db
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# Origenes permitidos (separados por coma, sin espacios)
